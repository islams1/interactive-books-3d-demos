  RPT["Renderpeople bodies - attachRP, updateRP, RP_MAP"]
  LOOK["Attention - attend, npcLook"]
  PL["Section 11 PLAYER - updatePlayer, collision boxes"]
  FIRE["Section 12 FIRE SPRAY SMOKE - updateFire"]
  EMO["Section 13 EMOTION - updateEmotion"]
  HUD["Section 15 HUD - safObjective"]
  ENDS["Endings - showEnding, renderEnding"]
  IN --> HSM
  IN --> CH
